# Restricted test-mode key with Read access to Charges, Customers, PaymentIntents,
# and PaymentMethods, and no other permissions. The agent refuses to start with anything else.
STRIPE_READONLY_KEY=rk_test_replace_me

# Standard test-mode secret key. Used only by `npm run seed` to create sample payments;
# the agent never loads it. Remove it from .env after seeding.
STRIPE_SEED_KEY=sk_test_replace_me

# Which model runs the investigation: "ollama" (local) or "cursor" (Cursor SDK).
LLM_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder:30b

# Cursor SDK. Create a key at cursor.com/dashboard/integrations.
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
